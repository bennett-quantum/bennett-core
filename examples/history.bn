; history.bn: `mark` and `rewind`. A rewind XORs chosen values into registers, then un-runs every step
; since its mark, gates and memory writes included, and the program continues after the rewind.
memory 256
data 0 = i8 0

; Writes its result to memory as well as returning it.
func @f(i8 %x) -> i8 {
entry:
    %t = mul i8 %x, 3
    %y = add i8 %t, 1
    store i8 %y, 0
    ret %y
}

; Mark, call, rewind keep: f(x) is copied into %out and every trace of the call is gone, so memory at 0
; is 0 again; returns it.
func @copied(q8 %out, i8 %x) -> i8 {
entry:
    %h = mark
    %y = call @f(%x)
    rewind %h keep (%y -> %out)
    %cell = load i8 0
    ret %cell
}

; Returns the measured copy in the high byte and memory at 0 in the low byte.
func @copy(i8 %x) -> i16 {
entry:
    %out = qalloc 8
    %cell = call @copied(%out, %x)
    %m = measure %out
    %high = zext i8 %m to i16
    %shifted = shl i16 %high, 8
    %low = zext i8 %cell to i16
    %packed = or i16 %shifted, %low
    ret %packed
}

; Un-running through a gate conjugates: H, then XOR 1, then un-running the H is H X H = Z. On |+> that
; gives |->, which a last H turns into |1>.
func @conjugated(q1 %q) {
entry:
    h %q
    %h = mark
    h %q
    rewind %h keep (i1 1 -> %q)
    h %q
    ret
}

; The measurement gives 1 for every seed.
func @conjugate() -> i1 {
entry:
    %q = qalloc 1
    call @conjugated(%q)
    %m = measure %q
    ret %m
}

; Marks nest. The inner rewind keeps 5 in %out; the outer rewind un-runs it again (by running the inner
; region once more and undoing it), so only the outer keep, 3, is left.
func @nested(q8 %out) {
entry:
    %outer = mark
    %inner = mark
    rewind %inner keep (i8 5 -> %out)
    rewind %outer keep (i8 3 -> %out)
    ret
}

func @nest() -> i8 {
entry:
    %out = qalloc 8
    call @nested(%out)
    %m = measure %out
    ret %m
}
