memory 128
func @main() {
entry:
    %q = qalloc 4
    h %q[0]
    h %q[1]
    x %q[2] ctrl %q[0], %q[1]
    z %q[3] ctrl %q[2], %q[1]
    x %q[3] ctrl %q[0], %q[1], %q[2]
    qfree %q
    ret
}

func @adaptive() -> i1 {
entry:
    %q = qalloc 1
    h %q
    %m = measure %q
    %next = measure %q
    br %m, one, zero
one:
    x %q
    x %q
    x %q
    x %q
    x %q
    x %q
    x %q
    x %q
    x %q
    x %q
    ret %m
zero:
    ret %m
}

func @dirty_discard() -> q1 {
entry:
    %old = qalloc 1
    x %old
    qfree %old
    %new = qalloc 1
    ret %new
}

func @clean_discard() -> q1 {
entry:
    %old = qalloc 1
    z %old
    qfree %old
    %new = qalloc 1
    ret %new
}

func @countdown(i2 %start) -> i2 {
entry:
    br test(%start, i2 0)
test(i2 %left, i2 %count):
    %done = icmp eq i2 %left, 0
    br %done, finish, more
more:
    %next = sub i2 %left, 1
    %inc = add i2 %count, 1
    br test(%next, %inc)
finish:
    ret %count
}

func @applied_countdown(i64 %budget) -> i2 {
entry:
    %x = qalloc 2
    x %x[0]
    x %x[1]
    %out = qalloc 2
    x %out[1]
    %fault = qalloc 5
    apply @countdown(%x) -> %out, %fault budget %budget
    %result = measure %out
    ret %result
}
