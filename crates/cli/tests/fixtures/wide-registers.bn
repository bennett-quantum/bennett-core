    x %c[49] ctrl %q[949]
    x %c[50] ctrl %q[950]
    x %c[51] ctrl %q[951]
    x %c[52] ctrl %q[952]
    x %c[53] ctrl %q[953]
    x %c[54] ctrl %q[954]
    x %c[55] ctrl %q[955]
    x %c[56] ctrl %q[956]
    x %c[57] ctrl %q[957]
    x %c[58] ctrl %q[958]
    x %c[59] ctrl %q[959]
    x %c[60] ctrl %q[960]
    x %c[61] ctrl %q[961]
    x %c[62] ctrl %q[962]
    x %c[63] ctrl %q[963]
    x %c[64] ctrl %q[964]
