; Registers wider than 64 qubits on the counting device and in the OpenQASM output
; (crates/cli/tests/wide_registers.rs).
memory 256

; A register of 1000 qubits: qubit 999 set, qubits 0 and 999 correlated across columns, a gate with three
; controls in three columns, then its top 100 qubits copied out, measured and the copy undone.
func @wide() -> i100 {
entry:
    %q = qalloc 1000
    x %q[999]
    h %q[0]
    x %q[999] ctrl %q[0]
    x %q[500] ctrl %q[0], %q[998], %q[999]
    %c = qalloc 100
    x %c[0] ctrl %q[900]
    x %c[1] ctrl %q[901]
    x %c[2] ctrl %q[902]
    x %c[3] ctrl %q[903]
    x %c[4] ctrl %q[904]
    x %c[5] ctrl %q[905]
    x %c[6] ctrl %q[906]
    x %c[7] ctrl %q[907]
    x %c[8] ctrl %q[908]
    x %c[9] ctrl %q[909]
    x %c[10] ctrl %q[910]
    x %c[11] ctrl %q[911]
    x %c[12] ctrl %q[912]
    x %c[13] ctrl %q[913]
    x %c[14] ctrl %q[914]
    x %c[15] ctrl %q[915]
    x %c[16] ctrl %q[916]
    x %c[17] ctrl %q[917]
    x %c[18] ctrl %q[918]
    x %c[19] ctrl %q[919]
