    x %c[76] ctrl %q[976]
    x %c[77] ctrl %q[977]
    x %c[78] ctrl %q[978]
    x %c[79] ctrl %q[979]
    x %c[80] ctrl %q[980]
    x %c[81] ctrl %q[981]
    x %c[82] ctrl %q[982]
    x %c[83] ctrl %q[983]
    x %c[84] ctrl %q[984]
    x %c[85] ctrl %q[985]
    x %c[86] ctrl %q[986]
    x %c[87] ctrl %q[987]
    x %c[88] ctrl %q[988]
    x %c[89] ctrl %q[989]
    x %c[90] ctrl %q[990]
