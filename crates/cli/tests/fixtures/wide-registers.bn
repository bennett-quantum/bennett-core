    x %c[28] ctrl %q[928]
    x %c[29] ctrl %q[929]
    x %c[30] ctrl %q[930]
    x %c[31] ctrl %q[931]
    x %c[32] ctrl %q[932]
    x %c[33] ctrl %q[933]
    x %c[34] ctrl %q[934]
    x %c[35] ctrl %q[935]
    x %c[36] ctrl %q[936]
    x %c[37] ctrl %q[937]
    x %c[38] ctrl %q[938]
    x %c[39] ctrl %q[939]
    x %c[40] ctrl %q[940]
    x %c[41] ctrl %q[941]
