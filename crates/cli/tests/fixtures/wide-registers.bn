    x %c[93] ctrl %q[993]
    x %c[94] ctrl %q[994]
    x %c[95] ctrl %q[995]
    x %c[96] ctrl %q[996]
    x %c[97] ctrl %q[997]
    x %c[98] ctrl %q[998]
    x %c[99] ctrl %q[999]
    qfree %c
    qfree %q
    ret %m
}

func @inc(i128 %x) -> i128 {
entry:
    %y = add i128 %x, 1
    ret %y
}

; `apply` to a 128-qubit register whose low 64 qubits are 1: the carry of x + 1 crosses the columns.
func @applied() -> i128 {
entry:
    %x = qalloc 128
    x %x[0]
    x %x[1]
    x %x[2]
    x %x[3]
    x %x[4]
    x %x[5]
    x %x[6]
    x %x[7]
    x %x[8]
    x %x[9]
    x %x[10]
    x %x[11]
    x %x[12]
    x %x[13]
    x %x[14]
    x %x[15]
    x %x[16]
    x %x[17]
    x %x[18]
    x %x[19]
    x %x[20]
    x %x[21]
    x %x[22]
    x %x[23]
    x %x[24]
    x %x[25]
    x %x[26]
    x %x[27]
    x %x[28]
    x %x[29]
    x %x[30]
    x %x[31]
    x %x[32]
    x %x[33]
    x %x[34]
    x %x[35]
    x %x[36]
    x %x[37]
    x %x[38]
    x %x[39]
    x %x[40]
    x %x[41]
    x %x[42]
    x %x[43]
    x %x[44]
    x %x[45]
    x %x[46]
    x %x[47]
    x %x[48]
    x %x[49]
    x %x[50]
    x %x[51]
    x %x[52]
    x %x[53]
    x %x[54]
    x %x[55]
    x %x[56]
    x %x[57]
    x %x[58]
    x %x[59]
    x %x[60]
    x %x[61]
    x %x[62]
    x %x[63]
    %o = qalloc 128
    %f = qalloc 5
    apply @inc(%x) -> %o, %f budget 4
    %m = measure %o
    ret %m
}

func @id(i128 %x) -> i128 {
entry:
    ret %x
}

; `apply` of the identity to a 128-qubit register holding only bit 127: the result's top bit.
func @top_bit() -> i128 {
entry:
    %x = qalloc 128
    %o = qalloc 128
    %f = qalloc 5
    x %x[127]
    apply @id(%x) -> %o, %f budget 4
    %m = measure %o
    ret %m
}
