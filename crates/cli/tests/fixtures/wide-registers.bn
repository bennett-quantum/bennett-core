    x %c[73] ctrl %q[973]
    x %c[74] ctrl %q[974]
    x %c[75] ctrl %q[975]
    x %c[76] ctrl %q[976]
    x %c[77] ctrl %q[977]
    x %c[78] ctrl %q[978]
    x %c[79] ctrl %q[979]
    x %c[80] ctrl %q[980]
    x %c[81] ctrl %q[981]
    x %c[82] ctrl %q[982]
    x %c[83] ctrl %q[983]
    x %c[84] ctrl %q[984]
    x %c[85] ctrl %q[985]
