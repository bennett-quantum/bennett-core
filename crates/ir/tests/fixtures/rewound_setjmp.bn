memory 512
func @main() -> i32 {
entry:
    %h = mark
    %buf = add i64 16, 0
    %s = setjmp %buf
    %first = icmp eq i32 %s, 0
    br %first, jump, done
jump:
    rewind %h
    ; Rebuild the valid record: frame 0 / function 0, entry instruction 2, entry SP, current SP.
    store i64 0, 16
    store i64 8589934592, 24
    store i64 512, 32
    store i64 480, 40
    longjmp 16, 7
done:
    ret %s
}
